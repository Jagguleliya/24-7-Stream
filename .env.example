# ============================================================
# Environment Variables Template
# DO NOT COMMIT REAL KEYS OR SECRETS TO A PUBLIC REPOSITORY!
# Copy this file to .env locally or set these in Render Dashboard
# ============================================================

# YouTube / Kick Live Stream Keys
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here
KICK_STREAM_KEY=your_kick_stream_key_here

# Monetization (Optional)
UPI_ID=your_upi_id@bank
UPI_QR_BASE64=

# Preview Mode (false = live broadcast 24/7)
PREVIEW_MODE=false
PORT=8080
